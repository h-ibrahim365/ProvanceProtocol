<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>Provance.AspNetCore.Middleware</PackageId>
    <Title>PROVANCE ASP.NET Core middleware</Title>
    <Description>ASP.NET Core middleware that records every HTTP request in a PROVANCE tamper-evident ledger.</Description>
    <PackageTags>aspnetcore;middleware;audit;audit-trail;tamper-evident;ledger</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>provanceMiddleWare.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <RootNamespace>Provance.AspNetCore.Middleware</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Provance.Core\Provance.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Provance.AspNetCore.Middleware.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\..\icons\provanceMiddleWare.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
