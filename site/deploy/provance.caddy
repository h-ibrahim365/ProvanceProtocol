# /etc/caddy/sites/provance.caddy, picked up by "import /etc/caddy/sites/*.caddy" in /etc/caddy/Caddyfile.
# Serves the demo site, forwards /api to provance-status and the GitHub webhook to the deploy listener.

provance.iamhakim.com {
	encode zstd gzip

	# GitHub webhook (signature checked by the listener)
	handle /hooks/provance-deploy {
		reverse_proxy 127.0.0.1:9002
	}

	# Release status for the Releases page
	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}

	# Static site (single page, the hash in the URL picks the page)
	handle {
		root * /opt/provance/web
		try_files {path} /index.html
		file_server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# cloudflareinsights: Cloudflare Web Analytics, injected when the zone has it enabled
		Content-Security-Policy "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'"
		-Server
	}
}
